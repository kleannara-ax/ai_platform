# ============================================================
#  환경변수 설정 (.env)
#  이 파일을 .env로 복사하여 실제 값을 입력하세요
#  cp .env.example .env
# ============================================================

# ── DB 접속 정보 ──
DB_HOST=localhost
DB_PORT=3306
DB_NAME=platform_db
DB_USERNAME=platform_user
DB_PASSWORD=비밀번호_입력

# ── JWT 시크릿 키 ──
# 생성: openssl rand -base64 64
JWT_SECRET=Base64_인코딩된_시크릿키_입력

# ── PS-INSP 모듈 ──
PS_INSP_UPLOAD_DIR=/data/upload/ps_cov_ins
